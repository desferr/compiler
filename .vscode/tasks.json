{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build compiler",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-static",
                "src/main.cpp",
                "src/lexer.cpp",
                "src/ops.cpp",
                "src/grammar.cpp",
                "src/parser.cpp",
                "src/interpreter.cpp",
                "-o",
                "build/compiler.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}